APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-random-64-character-secret
ADMIN_EMAIL=hallo@shortaktien.de
ADMIN_PASSWORD_HASH=replace-with-a-password-hash
GITHUB_REPOSITORY=shortaktien/blacktea-motorcycles
GITHUB_TOKEN=replace-with-a-server-side-token-with-issues-write
