{
  "name": "blacktea-hilfe/backend",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/dotenv": "^7.2",
    "symfony/framework-bundle": "^7.2",
    "symfony/runtime": "^7.2",
    "symfony/string": "^7.2",
    "symfony/yaml": "^7.2",
    "sentry/sentry-symfony": "^5.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.2.*"
    }
  }
}
