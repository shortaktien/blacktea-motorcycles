# Port 80 ist der Produktionsstandard. Port 5173 bleibt als interner
# Kompatibilitätsport für die bestehende öffentliche Caddy-Konfiguration aktiv.
:80, :5173 {
    encode zstd gzip
    root * /srv

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Vite fingerprints production assets, so they can be cached for a year.
    # Keep generated documents short-lived so sitemap and SEO changes become
    # visible without requiring a cache purge.
    @immutableAssets path /assets/*
    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

    @mediaAssets path /images/*
    header @mediaAssets Cache-Control "public, max-age=604800"

    @generatedDocuments path /robots.txt /sitemap.xml /llms.txt /llms-full.txt
    header @generatedDocuments Cache-Control "public, max-age=300, must-revalidate"

    # The public URL is the stable HTML entry in the sitemap.
    redir /pdfs /pdfs/index.html 301
    redir /pdfs/ /pdfs/index.html 301

    # Approved repair requests are loaded from the API, but still use the
    # prerendered request shell so each request has its own shareable URL.
    @repairRequestDetail path_regexp repair_request_detail ^/hilfe/anfragen/[a-f0-9]{32}/?$
    handle @repairRequestDetail {
        rewrite * /hilfe/anfragen/index.html
        file_server
    }

    # Public profiles are loaded by React from the API. Serve a dedicated HTML
    # shell, independent of login state, only for valid profile URL shapes.
    @profileDetail path_regexp profile_detail ^/profil/[a-f0-9]{32}/?$
    handle @profileDetail {
        header X-Robots-Tag "noindex, follow, noarchive"
        rewrite * /profil/index.html
        file_server
    }

    # Keep the API on the same origin while the frontend remains a static site.
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Resolve a published route to its generated /route/index.html without
    # falling back to the homepage. Unknown paths reach the explicit 404.
    @prerendered file {
        try_files {path}/index.html
    }
    handle @prerendered {
        rewrite * {http.matchers.file.relative}
        file_server
    }

    # Serve files such as assets, robots.txt, sitemap.xml and PDFs as-is.
    @assets file {
        try_files {path}
    }
    handle @assets {
        file_server
    }

    respond 404
}
