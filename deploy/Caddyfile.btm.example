# In den bestehenden Caddyfile übernehmen.
# Voraussetzung: Caddy läuft im selben Docker-Netzwerk wie der BTM-Stack.
# Der Frontend-Container ist im Produktionsmodus selbst ein statischer Caddy
# und lauscht intern auf Port 80. Der Vite-Dev-Server wird nicht veröffentlicht.

btm.shortaktien.de {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Route the API directly to the current production backend. Keeping this
    # explicit prevents a legacy API upstream from shadowing new routes.
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
