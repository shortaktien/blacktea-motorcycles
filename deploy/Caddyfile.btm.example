# Ausschnitt für den bestehenden öffentlichen Caddy auf dem VPS.
# Den vorhandenen btm.shortaktien.de-Block ersetzen, nicht doppelt anlegen.
# Erst aktivieren, wenn DNS, Zertifikat und der neue Anwendungsbuild bereit sind.

btm-community.de {
    handle /yandex_c2f094dcdecf3575.html {
        root * /srv/shortaktien/public
        file_server
    }
    @indexnow_key path /b39b7f8fe59a4f781143bfcbfed3f68b.txt
    handle @indexnow_key {
        respond "b39b7f8fe59a4f781143bfcbfed3f68b" 200
    }
    encode zstd gzip

    @api path /api/*
    reverse_proxy @api btm-backend-1:8000
    reverse_proxy btm-frontend-1:5173
}

btm.shortaktien.de {
    redir https://btm-community.de{uri} 308
}
